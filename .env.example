# Backend (copy to backend/.env or export in the shell)
DATABASE_URL=sqlite:///./repo_analyzer.db
CLONE_TIMEOUT_SECONDS=60
MAX_CLONE_SIZE_BYTES=314572800
MAX_FILES_ANALYZED=2000
MAX_FILE_SIZE_BYTES=1048576
# TEMP_DIR=   # defaults to the system temp directory
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# Frontend (copy to frontend/.env)
VITE_API_BASE_URL=http://localhost:8000
