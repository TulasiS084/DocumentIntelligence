# Backend (copy to backend/.env or export in the shell)
DATABASE_URL=sqlite:///./repo_analyzer.db
CLONE_TIMEOUT_SECONDS=60
MAX_CLONE_SIZE_BYTES=314572800
MAX_FILES_ANALYZED=2000
MAX_FILE_SIZE_BYTES=1048576
# TEMP_DIR=   # defaults to the system temp directory
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# Step 3 LLM Provider (gemini | groq | ollama)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# LLM Models per provider
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_MODEL=llama3.2

# Embedding & Vector Index
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHROMA_PATH=./chroma_data

# Limits & Retrieval parameters
MAX_SUMMARY_CALLS=60
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3
RETRIEVAL_TOP_K_EACH=20
RETRIEVAL_TOP_K_FINAL=6
RRF_K=60
MIN_CONFIDENCE=0.3

# Frontend (copy to frontend/.env)
VITE_API_BASE_URL=http://localhost:8000
